{
  "name": "@c-f-x/kit",
  "version": "0.3.0",
  "license": "MIT",
  "private": true,
  "description": "Shared code and rule checks for the c-f-x tools.",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "c-f-x": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./worker": {
      "types": "./dist/worker/index.d.ts",
      "default": "./dist/worker/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json && tsc -p test/tsconfig.json",
    "test": "node --test \"src/**/*.test.ts\" && vitest run"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.4.5",
    "@cloudflare/workers-types": "5.20261019.1",
    "@types/node": "26.6.5",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  },
  "dependencies": {
    "jsonc-parser": "3.3.1",
    "zod": "4.6.7"
  }
}
